{
  "name": "grc-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IT governance, risk and compliance platform (local prototype)",
  "scripts": {
    "start": "tsx server/src/main.ts",
    "server": "tsx watch server/src/main.ts",
    "web": "vite",
    "build": "vite build",
    "seed": "tsx server/src/cli.ts seed",
    "cli": "tsx server/src/cli.ts",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@node-rs/argon2": "^2.2.2",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
