# The build context is an allowlist: only what the image needs is sent to the builder.
# Everything else (data, backups, private seed files, secrets, local tools, notes, builds)
# never leaves this machine, whatever it is called.
*
!package.json
!package-lock.json
!vite.config.ts
!web/
!server/
!shared/
!docs/user/
!deploy/healthcheck.mjs
!deploy/grc

# Inside the allowed folders: tests and anything that looks like a secret stay out too.
server/src/**/*.test.ts
server/src/test/
web/src/**/*.test.ts
web/src/**/*.test.tsx
shared/**/*.test.ts
**/*.pem
**/*.key
**/*.pfx
**/.env
**/.env.*
**/node_modules/
