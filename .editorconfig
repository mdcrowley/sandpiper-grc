# Editor settings shared by everyone working on the repository. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Windows scripts keep Windows line endings (see .gitattributes).
[*.{ps1,psm1,psd1,cmd,bat}]
end_of_line = crlf

# Pipe- and comma-delimited data: leave the cells exactly as they are.
[*.{psv,csv}]
trim_trailing_whitespace = false
insert_final_newline = false
