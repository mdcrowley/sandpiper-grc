# Settings for compose.yaml. Copy this file to .env (git-ignored) and uncomment what you need.
# Every GRC_* line in .env is passed to the application; the first group only steers Compose.
# All of them are optional. The full list, with every server setting, is in docs/installation.md
# ("Environment variables") and docs/docker.md.

# --- Compose -------------------------------------------------------------------------------------
# The image to run. Default: the newest release. "edge" follows the main branch; a version such as
# 0.3.0 or 0.3 pins it. sandpiper-grc:local with `docker compose up -d --build` builds from source.
#GRC_IMAGE=ghcr.io/mdcrowley/sandpiper-grc:latest
# Host address and port the application is published on. Keep 127.0.0.1 unless a firewall and a
# reverse proxy that terminates HTTPS protect the port (docs/docker.md, "HTTPS").
#GRC_BIND=127.0.0.1
#GRC_PUBLISH_PORT=8080
# Use the PostgreSQL variant without typing both files (; instead of : on Windows).
#COMPOSE_FILE=compose.yaml:compose.postgres.yaml

# --- The organization ---------------------------------------------------------------------------
# Time zone (IANA name) for business hours, "today" and due dates. Default: UTC in the container.
# Decide it before recording real data.
#GRC_TIMEZONE=America/Chicago
# ISO 4217 currency code for money fields (display only). Default: USD.
#GRC_CURRENCY=USD

# --- Secret key ---------------------------------------------------------------------------------
# By default a key is generated on first start in the grc-key volume (not the data volume).
# To supply your own instead: 32 bytes as 64 hex characters (openssl rand -hex 32).
#GRC_SECRET_KEY=
# Or a file inside the container, for example a Compose secret mounted at /run/secrets/...
#GRC_SECRET_KEY_FILE=/run/secrets/grc_secret_key
# Retired keys, comma-separated, for one start after changing the key (docs/security.md).
#GRC_SECRET_KEY_PREVIOUS=

# --- Behind a reverse proxy ---------------------------------------------------------------------
# Which proxies may set X-Forwarded-For/-Proto/-Host. Default: gateway (the Docker host, where a
# proxy in front of the published port connects from). A proxy in another container: its address.
# No proxy: off. Avoid private: it trusts everyone on a private network (docs/docker.md).
#GRC_TRUST_PROXY=gateway
# Session cookie Secure flag: off | auto | always. auto is chosen by itself behind a trusted proxy.
#GRC_COOKIE_SECURE=auto
# Strict-Transport-Security on HTTPS responses: max-age in seconds (0 = off), and subdomains.
#GRC_HSTS_MAX_AGE=31536000
#GRC_HSTS_INCLUDE_SUBDOMAINS=1
# Passkeys: the host name people type, and the full origins, when the proxy changes them.
#GRC_WEBAUTHN_RP_ID=grc.example.test
#GRC_WEBAUTHN_ORIGINS=https://grc.example.test

# --- HTTPS served by the container itself (instead of a proxy) -----------------------------------
# Mount the files (for example with a compose.override.yaml), set both, and remove
# GRC_ALLOW_INSECURE from compose.yaml.
#GRC_TLS_CERT=/run/secrets/tls_cert
#GRC_TLS_KEY=/run/secrets/tls_key
# Seconds between looks at the certificate files for a renewal (0 = only on SIGHUP).
#GRC_TLS_RELOAD_SECONDS=60

# --- A PostgreSQL server elsewhere (compose.postgres.yaml runs one for you) ----------------------
#GRC_DATABASE_URL=postgres://grc@db.example.internal:5432/grc
#GRC_DATABASE_PASSWORD_FILE=/run/secrets/db_password
#GRC_DATABASE_SSL=verify
#GRC_DATABASE_SSL_CA=/run/secrets/db_ca
#GRC_DATABASE_SCHEMA=public
#GRC_DATABASE_POOL_MAX=10
# A least-privilege set-up: migrations run as this owner account, the server as GRC_DATABASE_URL's
# (docs/installation.md, "A least-privilege database role").
#GRC_DATABASE_MIGRATE_URL=postgres://grc_owner@db.example.internal:5432/grc
#GRC_DATABASE_MIGRATE_PASSWORD_FILE=/run/secrets/db_owner_password

# --- Backups ------------------------------------------------------------------------------------
# Key or passphrase file for encrypted backups and exports (mounted into the container).
#GRC_BACKUP_KEY_FILE=/run/secrets/backup_key
#GRC_BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase

# --- Attached files in an S3-compatible object store (configured under Administration) -----------
#GRC_S3_ACCESS_KEY_ID=
#GRC_S3_SECRET_ACCESS_KEY=
#GRC_S3_SESSION_TOKEN=

# --- Logs (docs/operations.md, "Logs") -----------------------------------------------------------
# error | warn | info | debug. The image writes every entry to the container output as JSON.
#GRC_LOG_LEVEL=info
#GRC_LOG_CONSOLE=json
# Rotation of /var/lib/sandpiper/data/logs/grc.log: size in MB, and old files kept.
#GRC_LOG_MAX_MB=10
#GRC_LOG_FILES=5
# off: no line per request.
#GRC_LOG_REQUESTS=on
# Log database statements slower than this many milliseconds (text only, never values).
#GRC_SLOW_QUERY_MS=500

# --- Background jobs ----------------------------------------------------------------------------
#GRC_JOBS_POLL_MS=10000

# Do not set GRC_PORT, GRC_HOST, GRC_DATA_DIR, GRC_BACKUP_DIR or GRC_WEB_DIST here: the image sets
# them to match its volumes, port mapping and health check.
